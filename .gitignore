# Emacs backup and recovery files
\#*\#
*~
.\#*

*.bson
/*.cdx.json
*.deb
*.dump
*.exe
*.log
*.out
*.pcap
*.playback
*.pyc
*.rpm
*.swp
*.tape
*.temp
*.zip
.DS_store
.godeps
.gopath
.idea
.ignore
/SARIF.json
/asc-dsc-interoperability
bin/
/data
/deb_build
/dev-bin
/mongo-release
/mongodb-database-tools-*
/mongodump/*/admin/
/mongodump/*/config/
/mongodump/*/mongodump_test_db
/mongodump/*/mongorestore_test_*/
/mongodump/*/prelude.json
/mongodump/*/test/
node_modules
/release.*
/report.json
/rpm_build
/sbom.json
/silkbomb.env
tags
/temp*
/test-cluster/
test/**/*.json
test/qa-tests/[0-9]*
test/qa-tests/install_compass
test/qa-tests/mongo*
test/qa-tests/venv
testing_output/
vendor/pkg

# Test fixtures are committed even though they match the extension patterns above, so un-ignore
# everything under a testdata directory. This must come after those patterns to take effect.
!**/testdata/**

# /release.* would otherwise ignore RELEASE.md on case-insensitive filesystems.
!/RELEASE.md

# test/**/*.json would otherwise ignore this committed file.
!test/shell_common/jsconfig.json

# Exceptions to the testdata un-ignore above: fixtures these tests generate at run time, which must
# not be committed.
/mongoimport/testdata/10k1dup10k.json
/mongorestore/testdata/10k1dup10k.bson
/mongorestore/testdata/index_collation/test/*
/mongorestore/testdata/txntest/oplog.bson
